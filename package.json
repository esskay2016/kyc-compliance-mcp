{
  "name": "kyc-compliance-mcp",
  "version": "1.0.0",
  "description": "MCP server exposing KYC/AML compliance tools backed by public data sources (OFAC, World Bank, OpenCorporates, NAICS industry risk)",
  "type": "module",
  "bin": {
    "kyc-compliance-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "agent": "tsx src/host/run-agent.ts",
    "server": "tsx src/server/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
